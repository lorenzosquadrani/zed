#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$repo_dir"
mode=${1:-install}
case "$mode" in
    --help|-h)
        printf '%s\n' \
            'Usage: ./script/pdf-install [--update|--build-only|--install-only]' \
            'Default: test, build in Toolbox, and replace ~/.local/zed.app.' \
            '--update: merge upstream/main first (clean main branch required).' \
            '--build-only: test and stage without changing the installed app.' \
            '--install-only: install the most recently staged build.' \
            'Close Zed before installation. Settings, databases and extensions are preserved.'
        exit 0
        ;;
    install|--update|--build-only|--install-only|--bundle) ;;
    *) printf 'Unknown option: %s\n' "$mode" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { printf 'Expected at most one option.\n' >&2; exit 2; }

if [[ "$mode" == --bundle ]]; then
    [[ -f /run/.toolboxenv ]] || { printf 'Use --build-only from the host.\n' >&2; exit 1; }
    [[ $(uname -m) == x86_64 ]] || { printf 'This bundle currently supports x86-64 Linux only.\n' >&2; exit 1; }
    export ZED_UPDATE_EXPLANATION="Personal PDF fork. Update with $repo_dir/script/pdf-install --update"
    cargo fmt -p remote -p pdf_viewer -- --check
    ITERATIONS=20 cargo test --locked -p pdf_viewer
    cargo test --locked -p remote --lib transport::ssh::tests
    script/generate-licenses

    # Retain the normal app ID and stable database scope, without claiming this
    # upstream-main fork is an official release or enabling stock auto-updates.
    export RELEASE_CHANNEL=stable
    export ZED_RELEASE_CHANNEL=stable
    export RELEASE_VERSION="$(script/get-crate-version zed)"
    export ZED_BUNDLE=true
    export CARGO_PROFILE_RELEASE_FAST_DEBUG=0
    export RUSTFLAGS='-C symbol-mangling-version=v0 --cfg tokio_unstable -C link-args=-Wl,--disable-new-dtags,-rpath,$ORIGIN/../lib'
    cargo build --locked --profile release-fast --target-dir target/pdf-native -p zed -p cli
    RUSTFLAGS='-C symbol-mangling-version=v0 --cfg tokio_unstable -C target-feature=+crt-static' \
        cargo build --locked --profile release-fast --target-dir target/remote_server \
        --target x86_64-unknown-linux-musl -p remote_server --features debug-embed

    mkdir -p target/pdf-install
    bundle_dir=$(mktemp -d "$repo_dir/target/pdf-install/bundle.XXXXXX")
    app_dir="$bundle_dir/zed.app"
    mkdir -p "$app_dir/bin" "$app_dir/libexec" "$app_dir/lib"
    cp target/pdf-native/release-fast/zed "$app_dir/libexec/zed-editor"
    cp target/pdf-native/release-fast/cli "$app_dir/bin/zed"
    cp target/remote_server/x86_64-unknown-linux-musl/release-fast/remote_server "$bundle_dir/remote_server"
    llvm-objcopy --strip-debug --discard-all "$app_dir/libexec/zed-editor"
    llvm-objcopy --strip-debug --discard-all "$app_dir/bin/zed"
    llvm-objcopy --strip-debug --discard-all "$bundle_dir/remote_server"
    gzip -n -c "$bundle_dir/remote_server" > "$app_dir/libexec/remote-server-linux-x86_64.gz"
    sha256sum "$app_dir/libexec/remote-server-linux-x86_64.gz" | cut -d ' ' -f 1 \
        > "$app_dir/libexec/remote-server-linux-x86_64.sha256"
    bash script/pdf-server-smoke "$app_dir/libexec/remote-server-linux-x86_64.gz"

    # Keep the host's GLib family: dynamically loaded host libraries must not
    # resolve against a different bundled GLib (same exclusions as bundle-linux).
    dependencies=$(ldd "$app_dir/libexec/zed-editor")
    if [[ "$dependencies" == *'not found'* ]]; then
        printf '%s\n' "$dependencies" >&2
        exit 1
    fi
    while IFS= read -r library; do
        case "${library##*/}" in
            libc.so*|libgcc_s.so*|libm.so*|libpthread.so*|libdl.so*|libasound.so*|\
            libglib-2.0.so*|libgobject-2.0.so*|libgio-2.0.so*|libgmodule-2.0.so*|\
            libpcre.so*|libpcre2-8.so*|libmount.so*|libblkid.so*|libselinux.so*|\
            libffi.so*|libresolv.so*|libz.so*) continue ;;
        esac
        cp -L -- "$library" "$app_dir/lib/"
    done < <(awk '/=> \// {print $3}' <<< "$dependencies")
    for size in 512 1024; do
        mkdir -p "$app_dir/share/icons/hicolor/${size}x${size}/apps"
        suffix=''
        [[ "$size" != 1024 ]] || suffix='@2x'
        cp "crates/zed/resources/app-icon$suffix.png" "$app_dir/share/icons/hicolor/${size}x${size}/apps/zed.png"
    done
    cp assets/licenses.md "$app_dir/licenses.md"
    git rev-parse HEAD > "$app_dir/commit"
    printf '%s\n' "$app_dir" > target/pdf-install/bundle-path
    printf 'Validated bundle staged at %s\n' "$app_dir"
    exit 0
fi

[[ ! -f /run/.toolboxenv ]] || { printf 'Run this command on the host, outside Toolbox.\n' >&2; exit 1; }
mkdir -p target/pdf-install
exec 9> target/pdf-install/install.lock
flock -n 9 || { printf 'Another fork build/install is already running.\n' >&2; exit 1; }

if [[ "$mode" == --update ]]; then
    [[ $(git branch --show-current) == main && -z $(git status --porcelain) ]] || {
        printf 'Update requires a clean main branch. Commit your changes first.\n' >&2; exit 1;
    }
    if ! git remote get-url upstream >/dev/null 2>&1; then
        git remote add upstream https://github.com/zed-industries/zed.git
    fi
    upstream_url=$(git remote get-url upstream)
    case "$upstream_url" in
        https://github.com/zed-industries/zed.git|git@github.com:zed-industries/zed.git) ;;
        *) printf 'Unexpected upstream URL: %s\n' "$upstream_url" >&2; exit 1 ;;
    esac
    git fetch upstream main
    if ! git merge --no-edit upstream/main; then
        if git rev-parse -q --verify MERGE_HEAD >/dev/null; then git merge --abort; fi
        printf 'Upstream merge failed; installation unchanged. Resolve the merge manually.\n' >&2
        exit 1
    fi
fi

if [[ "$mode" != --install-only ]]; then
    "$repo_dir/script/pdf-dev" bash "$repo_dir/script/pdf-install" --bundle
fi
[[ "$mode" != --build-only ]] || exit 0

app_dir=$(<target/pdf-install/bundle-path)
case "$app_dir" in
    "$repo_dir"/target/pdf-install/bundle.*/zed.app) ;;
    *) printf 'Invalid staged bundle path.\n' >&2; exit 1 ;;
esac
[[ -d "$app_dir" && ! -L "$app_dir" ]] || { printf 'Missing staged app. Rebuild first.\n' >&2; exit 1; }
[[ $(<"$app_dir/commit") == $(git rev-parse HEAD) ]] || {
    printf 'Source commit changed since staging. Rebuild before installing.\n' >&2; exit 1;
}
if pgrep -u "$(id -u)" -x 'zed|zed-editor' >/dev/null; then
    printf 'Build ready. Save your work and quit Zed, then run ./script/pdf-install --install-only\n' >&2
    exit 1
fi
for executable in "$app_dir/bin/zed" "$app_dir/libexec/zed-editor"; do
    dependencies=$(ldd "$executable")
    if [[ "$dependencies" == *'not found'* ]]; then
        printf 'Missing host libraries:\n%s\n' "$dependencies" >&2
        exit 1
    fi
done
"$app_dir/bin/zed" --version
"$app_dir/libexec/zed-editor" --help >/dev/null
checksum=$(sha256sum "$app_dir/libexec/remote-server-linux-x86_64.gz" | cut -d ' ' -f 1)
[[ "$checksum" == $(<"$app_dir/libexec/remote-server-linux-x86_64.sha256") ]] || {
    printf 'Bundled remote server checksum mismatch.\n' >&2; exit 1;
}

installation_parent="$HOME/.local"
installation="$installation_parent/zed.app"
launcher="$installation_parent/bin/zed"
[[ ! -L "$installation" ]] || { printf 'Refusing to replace a symlinked app directory.\n' >&2; exit 1; }
if [[ -e "$installation" && ! -x "$installation/libexec/zed-editor" ]]; then
    printf 'Existing app directory is not a recognized Zed installation.\n' >&2; exit 1
fi
if [[ -e "$launcher" || -L "$launcher" ]]; then
    [[ -L "$launcher" && $(readlink -f "$launcher") == "$(readlink -f "$installation/bin/zed")" ]] || {
        printf 'Existing zed command does not point to this installation; not replacing it.\n' >&2; exit 1;
    }
fi
mkdir -p "$installation_parent/bin" "$installation_parent/share/applications"
replacement_dir=$(mktemp -d "$installation_parent/zed-install.XXXXXX")
cp -a -- "$app_dir" "$replacement_dir/zed.app"
export APP_NAME=Zed APP_CLI="$installation/bin/zed" APP_ARGS='%U' DO_STARTUP_NOTIFY=true
export APP_ICON="$installation/share/icons/hicolor/512x512/apps/zed.png"
mkdir -p "$replacement_dir/zed.app/share/applications"
envsubst < crates/zed/resources/zed.desktop.in > "$replacement_dir/zed.app/share/applications/dev.zed.Zed.desktop"

if [[ -e "$installation" ]]; then mv -- "$installation" "$replacement_dir/previous.app"; fi
if ! mv -- "$replacement_dir/zed.app" "$installation"; then
    if [[ -d "$replacement_dir/previous.app" ]]; then mv -- "$replacement_dir/previous.app" "$installation"; fi
    printf 'Replacement failed; the previous app was restored.\n' >&2
    exit 1
fi
ln -sfn -- "$installation/bin/zed" "$launcher"
cp -- "$installation/share/applications/dev.zed.Zed.desktop" "$installation_parent/share/applications/dev.zed.Zed.desktop"
if command -v update-desktop-database >/dev/null; then
    update-desktop-database "$installation_parent/share/applications"
fi
rm -r -- "$replacement_dir"
printf 'Installed %s. Old application files removed; settings and application data preserved.\n' "$installation"
printf 'Launch: zed\nNext update: %s/script/pdf-install --update\nPush your source changes when ready: git push origin main\n' "$repo_dir"
